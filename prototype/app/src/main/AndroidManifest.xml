<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No backup and no device transfer: allowBackup is off and the
         data extraction rules exclude every domain. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KpmPrototype">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AUTOFILL SERVICE: owned by the autofill feature. -->
        <service
            android:name=".autofill.KpmAutofillService"
            android:exported="true"
            android:label="@string/autofill_service_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>

        <!-- Picker opened by the suggestion. The system starts it for result in
             the task of the requesting app. Empty taskAffinity and
             excludeFromRecents keep it out of the app's own task and out of
             the recents list. -->
        <activity
            android:name=".autofill.AutofillSelectActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/autofill_select_label"
            android:taskAffinity="" />
        <!-- END AUTOFILL SERVICE -->

    </application>

</manifest>
