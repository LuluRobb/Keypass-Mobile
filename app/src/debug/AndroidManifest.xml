<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: gallery of all screens and states with fake data.
     Start a state directly with
     adb shell am start -n de.lulurobb.keypassmobile/.ui.gallery.GalleryActivity -e scenario list -e theme dark -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".ui.gallery.GalleryActivity"
            android:exported="true"
            android:label="@string/gallery_label"
            android:taskAffinity="de.lulurobb.keypassmobile.gallery"
            android:theme="@style/Theme.KeyPassMobile"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- getLaunchIntentForPackage prefers CATEGORY_INFO, so debug builds resolve to MainActivity
             and not to the gallery. The merger adds this filter to MainActivity of the main manifest. -->
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>

        <!-- E2E hook: releases all persisted URI grants (see E2eHooks.kt). Exported for adb, but only
             callers holding DUMP (the adb shell) may send to it. Not part of the release build. -->
        <receiver
            android:name=".debug.ReleaseUriGrantsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="de.lulurobb.keypassmobile.debug.RELEASE_URI_GRANTS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
