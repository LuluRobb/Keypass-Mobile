<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: gallery of all screens and states with fake data.
     Start a state directly with
     adb shell am start -n de.lulurobb.keypassmobile/.ui.gallery.GalleryActivity -e scenario list -e theme dark -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".ui.gallery.GalleryActivity"
            android:exported="true"
            android:label="@string/gallery_label"
            android:theme="@style/Theme.KeyPassMobile"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
